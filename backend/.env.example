# 后端环境变量示例：复制为 .env 后按需修改，不要提交 .env

# 服务名称与调试开关
APP_NAME=校园美食地图
APP_ENV=development
DEBUG=true

# 本地开发监听地址与端口
HOST=127.0.0.1
PORT=8000

# 允许访问后端的前端地址，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据文件位置（第二步实现数据库时使用）
DATABASE_URL=sqlite:///../data/campus_food.db
UPLOAD_DIR=../data/shop_photos
MAP_DIR=../data/maps
