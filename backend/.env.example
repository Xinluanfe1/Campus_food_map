# 后端环境变量示例：复制为 .env 后按需修改，不要提交 .env

# 服务名称与调试开关
APP_NAME=校园美食地图
APP_ENV=development
DEBUG=true

# 本地开发监听地址与端口
HOST=127.0.0.1
PORT=8000

# 允许访问后端的前端地址，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据文件位置（第二步实现数据库时使用）
DATABASE_URL=sqlite:///../data/campus_food.db
UPLOAD_DIR=../data/shop_photos
MAP_DIR=../data/maps

# 初始化管理员密码（可选）：留空时初始化脚本会生成随机密码并打印一次
# 不要将真实密码写入版本库
ADMIN_INITIAL_PASSWORD=

# 认证与安全（第三步）
# JWT 密钥：开发环境可留空（服务启动时使用临时密钥，重启后需要重新登录）；
# 生产环境必须设置为足够长的随机字符串
JWT_SECRET=
# 访问令牌有效期（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 公网 HTTPS 部署时设置为 true，本地 HTTP 开发保持 false
COOKIE_SECURE=false
